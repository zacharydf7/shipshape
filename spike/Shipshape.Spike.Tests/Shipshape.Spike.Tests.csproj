<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" Version="3.2.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <!-- Lets `dotnet ef migrations script` load the toy contexts, to compare with the in-process scripts. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" PrivateAssets="all" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shipshape.Spike\Shipshape.Spike.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="DotnetEf\*.sql;Headers\*.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
